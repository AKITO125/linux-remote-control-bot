DISCORD_TOKEN=your_bot_token_here
ALLOWED_USER_IDS=123456789012345678
ALLOWED_CHANNEL_IDS=
COMMAND_TIMEOUT=30
WORK_DIR=/home/youruser

# ブロックするコマンド（カンマ区切り）
BLOCKED_COMMANDS=rm -rf /,mkfs,dd if=/dev/zero of=,:(){ :|:& };:,sudo rm,sudo dd

# ── 認証設定 ──────────────────────────────────────────────────
# Discordで要求されるパスワード（shutdown/reboot/kill/service操作時）
BOT_AUTH_PASSWORD=your_discord_auth_password_here

# LinuxのsudoパスワードをBotが自動入力する場合に設定
# 設定しない場合は sudoers に NOPASSWD を設定する必要あり
SUDO_PASSWORD=your_linux_sudo_password_here

# 認証失敗の上限回数（超えるとロック）
AUTH_MAX_FAILURES=3

# 認証ロック時間（分）
AUTH_COOLDOWN_MINUTES=5
